<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_search_robot"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <!-- Camera Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/camera_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Lidar Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLidar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lidar_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLidarStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Gamepad Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGamepad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gamepad_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGamepadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- RTK Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRtk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rtk_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRtkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Fusion Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchFusion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fusion_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFusionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Drive Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDrive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/drive_label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDriveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_status"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_telemetry"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/telemetry_placeholder"
            android:gravity="start"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:background="#1A000000"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Visual Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26000000"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- ID Klienta moved here -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/client_id_label"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etClientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="16sp"
                android:autofillHints="name" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchWatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/on_off_watch"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_pause"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnResume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_resume"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop" />
        </LinearLayout>

        <!-- Waypoints Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/waypoints_label"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnWaypointsStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnWaypointsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_status" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPowerOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_power_off"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
